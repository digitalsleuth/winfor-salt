{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "timezone": "America/Toronto",
  "schedule": ["after 6pm"],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "extractVersion": "^v?(?<version>.+)$"
    },
    {
      "description": "ms-word-parser is two different formats, but only needs one PR",
      "matchDepNames": ["jjrboucher/MS-Word-Parser", "ms-word-parser"],
      "groupName": "ms-word-parser"
    },
    {
      "description": "Ignore openhashtab for now",
      "matchFileNames": ["winfor/**/openhashtab.sls", "winfor/**/volatility3.sls", "winfor/**/pev.sls", "winfor/**/yara.sls", "winfor/**/velociraptor.sls"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub tools: repo comes from the source URL",
      "managerFilePatterns": ["/^winfor/(downloads/|offline/)?(installers|packages|python3-tools|standalones)/[^/]+\\.sls$/"],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "\\{% set version = ['\"](?<currentValue>[^'\"]+)['\"] %\\}",
        "https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/(?:releases/download|archive/refs/tags)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Annotated states (offline GitHub, PyPI)",
      "managerFilePatterns": ["/^winfor/(downloads/|offline/)?(installers|packages|python3-tools|standalones)/[^/]+\\.sls$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\r?\\n\\{% set version = ['\"](?<currentValue>[^'\"]+)['\"] %\\}"
      ]
    },
    {
      "customType": "regex",
      "description": "'# Version:' header line (GitHub tools, URL uses {{ version }})",
      "managerFilePatterns": ["/^winfor/(downloads/|offline/)?(installers|packages|python3-tools|standalones)/[^/]+\\.sls$/"],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "# Version: (?<currentValue>\\S+)[ \\t]*\\r?\\n",
        "https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/(?:releases/download|archive/refs/tags)/[^\\r\\n]*\\{\\{[^}\\r\\n]*\\bversion\\b"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "'# Version:' header line (annotated states)",
      "managerFilePatterns": ["/^winfor/(downloads/|offline/)?(installers|packages|python3-tools|standalones)/[^/]+\\.sls$/"],
      "matchStrings": [
        "# Version: (?<currentValue>\\S+)[ \\t]*\\r?\\n[\\s\\S]*?# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\r?\\n\\{% set version = "
      ]
    }
  ]
}
